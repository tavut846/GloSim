{
  "kind": "singleType",
  "collectionName": "home_pages",
  "info": {
    "singularName": "home-page",
    "pluralName": "home-pages",
    "displayName": "Home Page",
    "description": "Home page layout and section content"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "heroEyebrow": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "heroTitle": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "heroSubtitle": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "heroDescription": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "heroTagline": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "heroCtaPrimary": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "heroCtaSecondary": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "heroImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "orgIntroTitle": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "orgIntroBody": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "orgVideoCaption": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "orgVideo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["videos", "files"]
    },
    "chairmanVideoCaption": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "chairmanVideo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["videos", "files"]
    },
    "highlights": {
      "type": "component",
      "repeatable": true,
      "component": "home.highlight-item",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "featuredConference": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::conference.conference"
    },
    "spotlightTitle": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "spotlightSubtitle": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "spotlightGuests": {
      "type": "component",
      "repeatable": true,
      "component": "home.guest-item",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}
