# ===================================================
# GloSim Unified Environment Configuration
# ===================================================

# --- Frontend Settings ---
# Host port (connect via your host Nginx / SSL reverse proxy or direct dev): 5173
FRONTEND_PORT=5173
VITE_STRAPI_URL=http://localhost:1337
VITE_SITE_TITLE=Global Simulation Conference

# --- Backend Server & Port Settings ---
HOST=0.0.0.0
PORT=1337
BACKEND_PORT=1337

# --- Backend Application Security Keys ---
APP_KEYS=Gl0S1mAppKeyAlpha,Gl0S1mAppKeyBeta,Gl0S1mAppKeyGamma,Gl0S1mAppKeyDelta
API_TOKEN_SALT=glosim_api_token_salt_random_sec_key
ADMIN_JWT_SECRET=glosim_admin_jwt_secret_random_sec
TRANSFER_TOKEN_SALT=glosim_transfer_salt_random_sec
JWT_SECRET=glosim_main_jwt_secret_random_sec_123

# --- Database Storage Configuration ---
# Default deployment uses local SQLite storage. For external PostgreSQL, set DATABASE_CLIENT=postgres
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# --- PostgreSQL Settings (Used when DATABASE_CLIENT=postgres) ---
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=5432
# DATABASE_NAME=glosim_db
# DATABASE_USERNAME=glosim_db
# DATABASE_PASSWORD=
# DATABASE_SSL=false
