# Production Backend Runner (Prebuilt Artifact)
FROM node:20-alpine

RUN apk add --no-cache vips-dev

WORKDIR /opt/app

# Copy prebuilt backend application & production node_modules
COPY backend/ ./

# Copy root .env if present
COPY .env* ./

ENV NODE_ENV=production
ENV PATH=/opt/app/node_modules/.bin:$PATH

EXPOSE 1337

CMD ["npm", "run", "start"]
